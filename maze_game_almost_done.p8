end

function draw_explain()
	cls(1)
	print("your goal is to make it",2,2,14)
	print("to the end 'e' square.",2,8,14)
	print("abiltiy scroll: 🅾️",2,20,11)
	print("use ability:    ❎",2,26,11)
	print("abilities:",2,38,14)
	print("● destroy wall",2,44,8)
	print("😐∧   teleport",2,50,9)
	print("⧗    slow time",2,56,3)
