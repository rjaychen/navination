--animation
cur_frame = 1 -- spr animation
animating = false
transition = false
anim_seq = {100,104,108,160,164,164,164,164}
anim_speed =0.2

--animates the hand sprite using state var
function animate()
	if animating then 
			cur_frame += anim_speed
			if cur_frame > #anim_seq-anim_speed then
				animating = false
			end
	end
end

-- animates the transition between levels
function animate_lvl_start()
	-- define animation parameters
	local start_x = -8   -- start off-screen
	local mid_x = 50     -- center of the screen (assuming 128x128)
	local end_x = 136    -- off-screen right
	local speed = 5      -- speed of movement
	local pause_frames = 20  -- pause duration (60 frames = 1 second)

	-- static variables to track animation state
	if not transition then
		anim_state = "sweep_in"
		transition = true
		pos_x = start_x
		timer = 0
	end

	-- state machine for animation
	if anim_state == "sweep_in" then
		pos_x += speed
		if pos_x >= mid_x then
			pos_x = mid_x
			anim_state = "pause"
			timer = pause_frames -- start pause timer
		end
	elseif anim_state == "pause" then
		timer -= 1
		if timer <= 0 then
			anim_state = "sweep_out"
		end
	elseif anim_state == "sweep_out" then
		pos_x += speed
		if pos_x >= end_x then
			anim_state = "done" -- stop animation
			transition = false
		end
	end

	-- draw the sprite at current position
	spr(168, pos_x, 50, 4, 4)  -- assumes sprite id 1
end

