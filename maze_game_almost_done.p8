--raycast
fac=1

--[[
the following code uses dda raymarching 
to simulate a 3d environment
]]--
function raycast(i,px,py)
	local x,y,vx,vy,ix,iy=0,0,0,0,0,0

		// find starting tile
	x=px
	y=py
		
	// find ray direction
	local a=-(i-64)/512 --> panoramic angle
	--a=atan2(1,(i-64)/64) --straight
	vx=cos(pa+a)
	vy=sin(pa+a)
	--fac=cos(a)
	// find standard distance
	dx=abs(1/vx)
	dy=abs(1/vy)
		
	// find increment value
	ix=vx>0 and 1 or -1
	iy=vy>0 and 1 or -1
		
	// find initial offset
	if vx>0 then
		ox=(flr(x)-x+1)/vx
	else
		ox=abs((x-flr(x))/vx)
	end
	if vy>0 then
		oy=(flr(y)-y+1)/vy
	else
		oy=abs((y-flr(y))/vy)
	end
			
	while true do
		// horizontal intersection
		if ox<oy then
			x+=ix
			d=ox
			ox+=dx
			if mget(x,y)>0 or x<0 or x>31 or y<0 or y>31 then
				local tw=flr(64-h/d/fac)
				local bw=flr(64+h/d/fac)
				tline(i,tw,i,bw,(py+vy*d)%1*2+(mget(x,y)-1)*2,62,0,2/(bw-tw))
				break
			end
		else // vertical intersection
			y+=iy
			d=oy
			oy+=dy
			if mget(x,y)>0 or x<0 or x>31 or y<0 or y>31 then
				local tw=flr(64-h/d/fac)
				local bw=flr(64+h/d/fac)
				tline(i,tw,i,bw,(px+vx*d)%1*2+(mget(x,y)-1)*2,62,0,2/(bw-tw))
				break
			end
		end
		// check for ray collsion
	end
end

