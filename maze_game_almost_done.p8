--main
poke(0x5f2d, 7) --mouse info
px,py=1.5,1.5 --assume square maze
fx,fy=0,0
pa=0

// associate wall types? with a table here

h=40
cs={13,12,11} --wall colors

mouse_acc = 24
speed = 0.05
seed = 2
scene = "menu"

function round(n, dec)
 local power = 10^dec
 return flr((n * power)+0.5) / power
end

function dist(x1,y1,x2,y2)
	return sqrt((x2-x1)*(x2-x1)+(y2-y1)*(y2-y1))
end

function _init()
	scene = "menu"
end

function _update60()
	if scene == "menu" then
		update_menu()
	elseif scene == "explain" then
		update_explain()
	elseif scene == "game" then 
		update_game()
	elseif scene == "over" then
		update_over()
	end
	
	animate()
end

function _draw()
	if scene == "menu" then
	 draw_menu()
	elseif scene == "explain" then
		draw_explain()
	elseif scene == "game" then 
		draw_game()
	elseif scene == "over" then 
		draw_game_over()
	end
end
