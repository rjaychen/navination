function draw_game_over()
	cls(0)
	print("you failed to escape.",24,60,8)
	print("press ❎ to retry", 30, 68, 8)
end

function draw_game()
// background
	cls(5)
	rectfill(0,64,128,128,6)
	
	// check wal colli at each pos
		
	local cx,cy=0,0
	local col=false
	for i=0,3 do 
		cx =i%2==0 and 0.1 or -0.1
		cy =i>1 and 0.1 or -0.1
		local tile_val = mget(px+cx,py+cy) -- check if wall is in proximity
		if tile_val !=0 then col=true end
	end
	
	local new_x=mid(0,round(px,1),15) // can do +0.5 trick to create rounding`\
	local new_y=mid(0,round(py,1),15)
	
	--prevent player from hitting walls
	if col then 
		px = new_x
		py = new_y
	end
	
	for i=0,127 do
		raycast(i,px,py) --almost everything is drawn here
	end
	
	-- ui statements for debugging/player
	//	local col = mget(px,py)	
	--print("x:"..px,0,0,8)
	--print("y:"..py,0,6,8)
	local rf = animating and anim_seq[flr(cur_frame)] or 36
	spr(rf,91,91,4,4) -- hand animation
	local d = round(dist(new_x,new_y,fx,fy),1) 
	print("goal: ("..fx..","..fy..")",4,6,8)
	print("dist:"..d,4,12,8)
	print("ability: "..abilities[cur_ability],4,18,8)
	for i=1,destroy_charges do
		print("●",4+(i-1)*8,24,8)
	end
	--print("cx:"..new_x,0,12,8)
	--print("cy:"..new_y,0,18,8)
	--print("curframe:"..cur_frame,0,30,8)
	--print(animating,0,36,8)
	--print("lvl: "..lvl, 2,42,8)
	--print(slowdown_active, 2, 58, 8)
	print("time: "..remaining,80,6,slowdown_active and 4 or 8)
	print("slow: "..round(cooldown_timer,1), 80, 14,8)
	--print(col,63,63,8)
	--print("fx:"..fx.."  fy:"..fy,63,70,8)
	if transition then animate_lvl_start() end
	--::continue::
end
