--abilities
abilities = {"none","destroy", "teleport", "slow"}

function switch_ability()
 cur_ability = cur_ability + 1
 if cur_ability > #abilities then
  cur_ability = 1  -- reset to the first ability
 end
end

function use_ability()
	local a = abilities[cur_ability]
 if a == "none" then -- do nothing
 elseif a == "destroy" then
 	destroy_wall()
	elseif a == "teleport" then
		mark_or_teleport()
	elseif a == "slow" then 
		activate_slowdown()
	end
end

function destroy_wall()
 if destroy_charges > 0 then
 	local x, y, vx, vy, ix, iy, d, ox, oy = px, py, cos(pa), sin(pa), 0, 0, 0, 0, 0
  -- ray direction
  local dx = abs(1 / vx)
 	local dy = abs(1 / vy)
  -- step increments
  ix = vx > 0 and 1 or -1
  iy = vy > 0 and 1 or -1
  -- initial offsets
  ox = vx > 0 and (flr(x) - x + 1) / vx or abs((x - flr(x)) / vx)
  oy = vy > 0 and (flr(y) - y + 1) / vy or abs((y - flr(y)) / vy)
  -- raycast loop
  while true do
   if ox < oy then
    x += ix
    d = ox
    ox += dx
   else
    y += iy
    d = oy
    oy += dy
   end

  --if we hit a wall, destroy it
   if mget(x, y) > 0 then
 	  mset(x, y, 0) -- remove the wall
    destroy_charges -= 1
    return
   end

  -- prevent out-of-bounds
   if x < 0 or x > 31 or y < 0 or y > 31 then
    return
   end
  end
 end   
end

function mark_or_teleport()
 if not marked then
 	mark_x = px
  mark_y = py
  marked = true
 else
  px = mark_x
  py = mark_y
  marked = false  -- reset after teleporting
 end
end

slowdown_active = false  -- is the slowdown currently active?
slowdown_duration = 5  -- duration of the slowdown in seconds
slowdown_cooldown = 10  -- cooldown period in seconds
slowdown_timer = 0  -- timer for how long the slowdown effect has been active
cooldown_timer = 0  -- timer for the cooldown period
original_remaining = 0
function activate_slowdown()
    if cooldown_timer <= 0 then  -- only activate if cooldown is finished
     slowdown_active = true
     slowdown_timer = slowdown_duration  -- set the duration of the slowdown
     cooldown_timer = slowdown_cooldown  -- set the cooldown period
    	original_remaining = remaining
    end
end

-- function to update timers and handle cooldown/slowdown
function update_slowdown()
    if slowdown_active then
        slowdown_timer = slowdown_timer - 1 / 60  -- slow down the countdown by 1/60 each frame
        if slowdown_timer <= 0 then
         slowdown_active = false  -- deactivate slowdown when time is up
       		remaining = remaining 		
        end
    end 
    -- cooldown countdown for the slowdown ability
    if cooldown_timer > 0 then
        cooldown_timer = cooldown_timer - 1 / 60  -- cooldown decreases by 1/60 each frame
    end
end
