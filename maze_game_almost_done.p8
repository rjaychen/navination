--updates

function reset_game() --init game.
	if not stat(57) then	music(0) end
	lvl, px, py, pa = 1,1.5,1.5,0
	scene, lvl_time = "menu", 10*lvl
	last = time()
	remaining = lvl_time
 size, cur_ability=3,1
	local msize=grid2map(size) 
	fx,fy=make_maze(size,size,seed) -- returns farthest point
	scene = "game"
	destroy_charges=1
	animate_lvl_start()
end

function update_menu()
	if btnp(❎) then
		reset_game()
	elseif btnp(🅾️) then
		scene = "explain"
	end
end

function update_explain()
	if btnp(🅾️) or btnp(❎) then
		scene = "menu"
	end
end

function update_over()
	if btnp(❎) then
		reset_game()	
	end
end

function update_game()
	// player control
		if btn(0) then
			pa+=0.01
			if pa>1 then
				pa-=1
			end
		end
	 	if btn(1) then
			pa-=0.01
			if pa<0 then
			 pa+=1
		 end
		end
		-- get mouse movement
		local mouse_dx = mid(-1, stat(38) / mouse_acc, 1)
		if abs(mouse_dx) > 0 then
			pa -= mouse_dx / mouse_acc
		end
		if btn(2) then
			px+=cos(pa)*speed
			py+=sin(pa)*speed
		end
		if btn(3) then
			px-=cos(pa)*speed
			py-=sin(pa)*speed
		end
		
		-- this is your equip scroll wheel
		if btnp(🅾️) then switch_ability() end
		
		-- use the abiltiy and animate
		if btnp(❎) then
			animating = true
			cur_frame = 1
			anim_timer = 0
			use_ability()
		end
		
		-- specifically for slowdown ability
		if slowdown_active then 
			remaining =  round(original_remaining - (time() - last) * 0.5, 1)
		else
			remaining = round(lvl_time - (time() - last), 1) 
		end
		
		--reset to next level		
		if round(px,0)==fx and round(py,0)==fy then 
			lvl = lvl+1
			lvl_time = (lvl*10)+remaining
			last = time()
			size=size+1
			fx,fy=make_maze(size,size,seed)
			px,py=1.5,1.5
			destroy_charges = flr((lvl - 1) / 3) + 1
			animate_lvl_start()
		end
		
		if remaining < 0 then scene = "over" end
		
		update_slowdown()
		
end

