pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
--main
poke(0x5f2d, 7) --mouse info
px,py=1.5,1.5 --assume square maze
fx,fy=0,0
pa=0

// associate wall types? with a table here

h=40
cs={13,12,11} --wall colors

mouse_acc = 24
speed = 0.05

gstate = 0

function round(n, dec)
 local power = 10^dec
 return flr((n * power)+0.5) / power
end

function dist(x1,y1,x2,y2)
	return sqrt((x2-x1)*(x2-x1)+(y2-y1)*(y2-y1))
end

function _init()
	gstate, lvl_time = 0, 300
	remaining = lvl_time
	last = time()
 size=3
	local msize=grid2map(size) 
	fx,fy=make_maze(size,size,2) -- returns farthest point
	
	--mset(fx-1,fy,3)
	--mset(fx,fy-1,3)
end

function _update60()
	if gstate == 0 then 
		// player control
		if btn(0) then
			pa+=0.01
			if pa>1 then
				pa-=1
			end
		end
	 	if btn(1) then
			pa-=0.01
			if pa<0 then
			 pa+=1
		 end
		end
		local mouse_dx = mid(-1, stat(38) / mouse_acc, 1)
		if abs(mouse_dx) > 0 then
			pa -= mouse_dx / mouse_acc
		end
		if btn(2) then
			px+=cos(pa)*speed
			py+=sin(pa)*speed
		end
		if btn(3) then
			px-=cos(pa)*speed
			py-=sin(pa)*speed
		end

		--reset the level		
		if round(px,0)==fx and round(py,0)==fy then 
			lvl_time = lvl_time*1.5
			size=size+1
			fx,fy=make_maze(size,size,2)
			px,py=1.5,1.5
		end
		
		remaining = round(lvl_time-time()-last,1)
		if remaining < 0 then gstate = 1 end	
	end
	if gstate == 1 then 
		if btnp(4) then 
			_init() --doesnt work
		end
	end
end

function _draw()
	if gstate == 1 then 
		cls(0)
		print("game over :(",40,63,8)
		goto continue
	end
	// background
	cls(5)
	rectfill(0,64,128,128,6)
	
	// check wal colli at each pos
		
	local cx,cy=0,0
	local col=false
	for i=0,3 do 
		cx =i%2==0 and 0.1 or -0.1
		cy =i>1 and 0.1 or -0.1
		local tile_val = mget(px+cx,py+cy)
		if tile_val !=0 then col=true end
	end
	
	local new_x=mid(0,round(px,1),15) // can do +0.5 trick to create rounding`\
	local new_y=mid(0,round(py,1),15)
	
	if col then 
		px = new_x
		py = new_y
	end
	
	for i=0,127 do
		raycast(i,px,py)
	end
	
	//	local col = mget(px,py)	
	--print("x:"..px,0,0,8)
	--print("y:"..py,0,6,8)
	local d = round(dist(new_x,new_y,fx,fy),1) 
	print("dist:"..d,0,6,8)
	print("cx:"..new_x,0,12,8)
	print("cy:"..new_y,0,18,8)
	print("time: "..remaining,70,6,8)
	print(col,63,63,8)
	print("fx:"..fx.."  fy:"..fy,63,70,8)
	::continue::
end
-->8
--maze generation

function shuffle(tbl)
 for i = #tbl,2,-1 do
  local j = flr(rnd(i))
  tbl[i], tbl[j] = tbl[j], tbl[i]
 end
end
  
tree = {}
tree.__index = tree
  
function tree:new()
 local instance = setmetatable({}, tree)
 instance.parent = nil
 return instance
end
  
function tree:root()
 return self.parent and self.parent:root() or self
end
  
function tree:connected(tree)
 return self:root() == tree:root()
end
  
function tree:connect(tree)
 tree:root().parent = self
end

function grid2map(x) 
	return (2*(x-1))+1
end

function bfs_longest_path(grid,dx,dy,width, height, sx, sy)
  local queue = {{sx, sy, 0}} 
  local visited = {}
  local fx, fy, longest = sx, sy, 0
  while #queue > 0 do
    local coord = queue[1]
    deli(queue,1)
    local x, y, dist = coord[1], coord[2], coord[3]
    if not visited[y] then visited[y] = {} end
    if visited[y][x] then goto continue end -- skip visited squares
    visited[y][x] = true
    -- update max distance found
    if dist > longest then
      longest = dist
      fx, fy = x, y
    end
    -- loop over available directions
    for _, dir in ipairs(grid[y][x]) do  -- loop over all stored directions
      local nx, ny = x + dx[dir], y + dy[dir]
      if nx >= 1 and nx <= width and ny >= 1 and ny <= height then
        add(queue, {nx, ny, dist + 1})
      end
    end
    ::continue::
  end
  return fx,fy,longest
end
  
function kruskal(height,width,seed)
 srand(seed) --can use os.time()
 local grid, sets, edges = {},{},{}
 local n,s,e,w = 1,2,4,8
 local dx = {[e] = 1, [w] = -1, [n] = 0, [s] = 0}
 local dy = {[e] = 0, [w] =  0, [n] = -1, [s] = 1}
 local opposite = {[e] = w, [w] = e, [n] = s, [s] = n}
  
 for i = 1, height do grid[i] = {}
  for j = 1, width do grid[i][j] = {} end
 end
  
 for i = 1, height do sets[i] = {}
  for j = 1, width do sets[i][j] = tree:new() end
 end
  
 for y = 1, height do 
  for x = 1, width do
    if y > 1 then add(edges,{x-1,y-1,n}) end
    if x > 1 then add(edges, {x-1,y-1,w}) end
  end
 end
  
 shuffle(edges)
  
 while #edges > 0 do
  local edge = edges[#edges] -- "pop"
  deli(edges,#edges)
  local x,y,direction = edge[1], edge[2], edge[3]
  local nx,ny = x + dx[direction], y + dy[direction]
  local set1, set2 = sets[y+1][x+1], sets[ny+1][nx+1]
  if not set1:connected(set2) then
   set1:connect(set2)
   add(grid[y+1][x+1], direction)
   add(grid[ny+1][nx+1], opposite[direction])
  end
 end
 local fx,fy,maxi = bfs_longest_path(grid,dx,dy,width,height,1,1)
 return grid,dx,dy,fx,fy
end
  
function make_maze(height,width,seed)
	// generate standard grid
 maph = 2*height+1
 mapw = 2*width+1
 for i=0,mapw-1 do
  for j=0,maph-1 do
   local cur=(i%2==0 or j%2==0) and 1 or 0
   mset(i, j, cur)
 	end
 end
      
 local grid,dx,dy,fx,fy = kruskal(height,width,seed)
 for y=1,#grid do
  for x=1,#grid[1] do
   local ny,nx = (2*(y-1))+1,(2*(x-1))+1
   --print(ni.." "..nj)
   for i=1,#grid[y][x] do
    local dir = grid[y][x][i]
    mset(nx+dx[dir],ny+dy[dir],0)
  	end
   --print(grid[i][j])
   --print(dx[dir])
  end	
 end
	mset(0,0,2) --set starting tiles
	mset(1,0,2)
	mset(0,1,2)
	--set ending tiles
	local gridfx, gridfy=grid2map(fx),grid2map(fy)
	for i=0,3 do
		local nx=i>2 and (i>3 and gridfx+1 or gridfx-1) or gridfx
		local ny=i<2 and (i<1 and gridfy+1 or gridfy-1) or gridfy
		if (mget(nx,ny)~=0) then
			mset(nx,ny,3)
		end
	end
	
	return gridfx,gridfy
end
-->8
--raycast
fac=1
function raycast(i,px,py)
	local x,y,vx,vy,ix,iy=0,0,0,0,0,0

		// find starting tile
	x=px
	y=py
		
	// find ray direction
	a=-(i-64)/512 --> panoramic angle
	--a=atan2(1,(i-64)/64) --straight
	vx=cos(pa+a)
	vy=sin(pa+a)
	--fac=cos(a)
	// find standard distance
	dx=abs(1/vx)
	dy=abs(1/vy)
		
	// find increment value
	ix=vx>0 and 1 or -1
	iy=vy>0 and 1 or -1
		
	// find initial offset
	if vx>0 then
		ox=(flr(x)-x+1)/vx
	else
		ox=abs((x-flr(x))/vx)
	end
	if vy>0 then
		oy=(flr(y)-y+1)/vy
	else
		oy=abs((y-flr(y))/vy)
	end
			
	while true do
		// horizontal intersection
		if ox<oy then
			x+=ix
			d=ox
			ox+=dx
			if mget(x,y)>0 or x<0 or x>31 or y<0 or y>31 then
				tw=flr(64-h/d/fac)
				bw=flr(64+h/d/fac)
				tline(i,tw,i,bw,(py+vy*d)%1*2+(mget(x,y)-1)*2,62,0,2/(bw-tw))
				break
			end
		else // vertical intersection
			y+=iy
			d=oy
			oy+=dy
			if mget(x,y)>0 or x<0 or x>31 or y<0 or y>31 then
				tw=flr(64-h/d/fac)
				bw=flr(64+h/d/fac)
				tline(i,tw,i,bw,(px+vx*d)%1*2+(mget(x,y)-1)*2,62,0,2/(bw-tw))
				break
			end
		end
		// check for ray collsion
		
	end
end

